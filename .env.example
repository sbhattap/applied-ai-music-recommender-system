# Claude (planner, check, explainer). Alternatively run `ant auth login` and leave
# this empty. Without credentials the app runs offline: heuristic planner,
# deterministic checks, grounded template explanations.
ANTHROPIC_API_KEY=

# Optional model overrides (defaults: claude-opus-5-5 for every step)
# RECOMMENDER_MODEL=claude-opus-5-5
# RECOMMENDER_FAST_MODEL=claude-haiku-5-5   # cheaper/faster check + explain

# Spotify (Development Mode app; owner needs Premium; max 5 allowlisted users).
# Register BOTH redirect URIs in the Spotify dashboard (localhost is not allowed):
#   http://127.0.0.1:8501            (Streamlit)
#   http://127.0.0.1:8888/callback   (scripts/spotify_login.py)
SPOTIFY_CLIENT_ID=
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:8501

# Last.fm crowd tags for the RAG knowledge store (scripts/build_knowledge.py)
LASTFM_API_KEY=
